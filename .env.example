# Copiar este archivo como ".env" y completar los valores.
# NUNCA subir el archivo ".env" real al repositorio (esta en .gitignore y .dockerignore).

# Credenciales de PostgreSQL (las usan el contenedor db y las tres replicas)
DB_USER=rutaexpress
DB_PASSWORD=cambiar_esta_clave
DB_NAME=envios

# Demora simulada para la prueba de timeout.
# false = desactivada (valor normal). true = la replica acepta la cabecera X-Simular-Demora-Ms.
# Activar solo durante la prueba y volver a false al terminar.
PERMITIR_DEMORA=false
